# W0 runs with no environment file or services. This optional flag disables
# anonymous Next.js CLI telemetry during local development.
# NEXT_TELEMETRY_DISABLED=1

# Used only when a server-side banking adapter is instantiated. Include /api/v1.
# Use a trusted HTTPS service URL, or HTTP loopback in development.
# BANKING_API_BASE_URL=

# Reserved for the later BFF integration. Keep actual values in ignored
# .env.local or the deployment secret manager.
# APP_ORIGIN=
# KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# WEB_DATABASE_URL=
# BETTER_AUTH_SECRET=
