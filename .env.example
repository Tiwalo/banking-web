# W0 runs with no environment file or services. This optional flag disables
# anonymous Next.js CLI telemetry during local development.
# NEXT_TELEMETRY_DISABLED=1

# Reserved for the later BFF integration. W0 does not read these variables.
# Keep actual values in ignored .env.local or the deployment secret manager.
# APP_ORIGIN=
# BANKING_API_BASE_URL=
# KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# WEB_DATABASE_URL=
# BETTER_AUTH_SECRET=
