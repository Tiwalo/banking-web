{
  "name": "banking-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview:design": "vite --config design-preview/vite.config.mts",
    "test:design": "playwright test --config playwright.design.config.ts",
    "contract:generate": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check",
    "test:contract": "vitest run tests/contract"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.8.4"
  }
}
